# ======================================================================

# 🚀 CodeIgniter 4 - SINDEN Optimized (PHP 8.2 + LiteSpeed cPanel)

# ======================================================================

# --- 1. KUNCI MUTLAK PHP 8.2 UNTUK CPANEL ---

# php -- BEGIN cPanel-generated handler, do not edit

<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# --- 2. KEAMANAN DASAR ---

# Mencegah orang melihat isi folder jika tidak ada file index

Options -Indexes

# --- 3. REWRITE ENGINE (CODEIGNITER 4) ---

<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # Tandai request HTTPS (native TLS atau reverse proxy/Cloudflare) untuk HSTS bersyarat
    RewriteCond %{HTTPS} on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =https [OR]
    RewriteCond %{HTTP:CF-Visitor} "scheme":"https"
    RewriteRule ^ - [E=IS_HTTPS:1]

    # Sembunyikan index.php dan arahkan semua request ke CI4 Front Controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,NC,QSA]

    # Pastikan Header Authorization terbaca (Sangat penting untuk API/Webhook)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

</IfModule>

# --- 4. OPTIMASI SERVER LITESPEED (IdCloudHost) ---

<IfModule litespeed>
    RewriteRule .* - [E=noconntimeout:1]
</IfModule>

# --- 5. PAKSA LIMIT UPLOAD PHP UNTUK FOTO HP (50MB) ---

<IfModule lsapi_module>
   php_value max_execution_time 300
   php_value memory_limit 512M
   php_value upload_max_filesize 50M
   php_value post_max_size 50M
</IfModule>

<IfModule mime_module>
   php_value upload_max_filesize 50M
   php_value post_max_size 50M
</IfModule>

# --- 6. SECURITY HEADERS (HTTP Observatory & OWASP Hardening) ---

<IfModule mod_headers.c>
   Header always unset X-Powered-By
   Header unset X-Powered-By

   Header always set X-Frame-Options "SAMEORIGIN"
   Header always set X-Content-Type-Options "nosniff"
   Header always set Referrer-Policy "strict-origin-when-cross-origin"
   Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
   Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()"

   # HSTS hanya dikirim saat koneksi HTTPS aktif (tidak memecahkan localhost HTTP)
   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=IS_HTTPS
   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=REDIRECT_IS_HTTPS
</IfModule>
